# Copy this file to .env in the same directory before starting the stack:
#   cp env.example .env
# docker-compose reads .env automatically; this example file is never read directly.

# PostgreSQL database configuration
POSTGRES_USER=automation
POSTGRES_PASSWORD=automation
POSTGRES_DB=automation

# Host port for Postgres. Defaults to 5433 to avoid clashing with a local
# Postgres install already using 5432.
POSTGRES_PORT=5433

# Host ports for the application
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend configuration
# Comma-separated list of allowed browser origins.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Base URL the frontend uses to reach the backend. Baked in at image build time.
REACT_APP_API_URL=http://localhost:8000

# Email notification block (optional for now)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
